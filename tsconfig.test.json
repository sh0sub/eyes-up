{
  // Node-side typecheck for tests and all scripts. Lens Studio globals (BaseScriptComponent,
  // vec3, SceneObject, ...) come from typings/lens-studio-shim.d.ts, a minimal hand-written
  // stand-in that is never shipped to Lens Studio.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020"],
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["vitest/globals"]
  },
  "include": ["Assets/**/*.ts", "typings/**/*.d.ts", "tests/**/*.ts", "vitest.config.ts"]
}
